# Variáveis de ambiente do Brasileirão Fantasy.
#
# Como usar: copie este arquivo para .env.local (que o Git ignora) e preencha.
#   cp .env.example .env.local
# NUNCA commite valores reais. No Codespace, prefira cadastrar os valores em
# GitHub → Settings → Codespaces → Secrets (eles viram variáveis de ambiente).

# String de conexão do PostgreSQL no Neon (use a URL *pooled*, com "-pooler" no host).
# Cada dev usa a sua própria branch do Neon. Formato:
# postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require
DATABASE_URL=

# Segredo usado pelo Better Auth para assinar sessões/tokens (ainda não usado).
# Gere um valor aleatório com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL base da aplicação, usada pelo Better Auth (ainda não usado).
# Local: http://localhost:3000 — no Codespace, a URL encaminhada da porta 3000.
BETTER_AUTH_URL=
